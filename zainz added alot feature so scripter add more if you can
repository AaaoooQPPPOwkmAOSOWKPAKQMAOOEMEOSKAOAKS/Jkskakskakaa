-- Auto Collect Loop updated with the Selected Dropdown Item support
task.spawn(function()
	local itemRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Item", 5)
	while true do
		task.wait(1)
		if ConfigData.AutoCollect and itemRemote then
			pcall(function()
				local char = player.Character
				if char and char:FindFirstChild("HumanoidRootPart") then
					local hrp = char.HumanoidRootPart
					local selectedName = (ConfigData.SelectedAutoCollectItem or "Apple"):lower()
					for _, obj in ipairs(workspace:GetDescendants()) do
						if not ConfigData.AutoCollect then break end
						if obj.Name:lower() == selectedName or obj.Name:lower():find(selectedName:gsub("'", "")) then
							local desc = (obj.Name .. " " .. (obj.Parent and obj.Parent.Name or "")):lower()
							if not (desc:find("shop") or desc:find("stand") or desc:find("vendor") or desc:find("store") or desc:find("pedestal")) then
								local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
								if targetPart and targetPart:IsA("BasePart") then
									hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
									task.wait(0.3)
									local id = targetPart:GetAttribute("ItemId") or (targetPart.Parent and targetPart.Parent:GetAttribute("ItemId"))
									if id then
										pcall(function() itemRemote:FireServer(id) end)
									end
									UserInputService:SendKeyEvent(true, Enum.KeyCode.F, false, game)
									task.wait(0.3)
									UserInputService:SendKeyEvent(false, Enum.KeyCode.F, false, game)
									break
								end
							end
						end
					end
				end
			end)
		end
	end
end)
