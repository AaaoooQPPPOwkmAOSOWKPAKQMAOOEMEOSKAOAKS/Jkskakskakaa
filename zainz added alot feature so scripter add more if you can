local function getGloveValue(targetPlayer)
	local gloveObj = targetPlayer:FindFirstChild("Glove") or (targetPlayer:FindFirstChild("leaderstats") and targetPlayer.leaderstats:FindFirstChild("Glove"))
	if not gloveObj then return "Unknown" end
	local success, val = pcall(function() return gloveObj.Value end)
	if success and val ~= nil then return tostring(val) end
	return "Unknown"
end

