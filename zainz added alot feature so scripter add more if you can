function Combat.GetSlapRemote()
	local cached = Combat.SlapRemote
	if cached and cached.Parent and cached:IsA("RemoteEvent") then
		return cached
	end
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local remote = remotes and remotes:FindFirstChild("Slap")
	if remote and remote:IsA("RemoteEvent") then
		Combat.SlapRemote = remote
		return remote
	end
	Combat.SlapRemote = nil
	return nil
end

function Combat.SetSlapAuraMode(mode, silent)
	mode = tostring(mode or "Fast")
	if mode ~= "Default" then
		mode = "Fast"
	end
	Combat.SlapAuraMode = mode
	Combat.SlapAuraInterval = mode == "Default" and Combat.SlapAuraDefaultInterval or Combat.SlapAuraFastInterval
	Combat.AutoGloveTapDebounce = mode == "Default" and Combat.SlapAuraDefaultInterval or 0.12
end

function Combat.SetSlapAuraIgnoreFriends(state)
	Combat.SlapAuraIgnoreFriends = state == true
end

function Combat.CanUseSlapAuraTarget(targetPlayer, localCharacter, localRoot)
	if targetPlayer == player then
		return nil, nil
	end
	localCharacter = localCharacter or player.Character
	localRoot = localRoot or (localCharacter and localCharacter:FindFirstChild("HumanoidRootPart"))
	local targetCharacter = targetPlayer.Character
	local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
	if not localCharacter or not localRoot or not targetCharacter or not targetRoot then
		return nil, nil
	end
	if targetCharacter:FindFirstChild("Dead") then
		return nil, nil
	end
	if targetCharacter:GetAttribute("inBus") == true or localCharacter:GetAttribute("inBus") == true then
		return nil, nil
	end
	if targetCharacter:GetAttribute("inMatch") ~= true or localCharacter:GetAttribute("inMatch") ~= true then
		return nil, nil
	end
	if localCharacter:GetAttribute("Ragdolled") ~= false then
		return nil, nil
	end
	local offset = localRoot.Position - targetRoot.Position
	if offset:Dot(offset) > Combat.SlapAuraRange * Combat.SlapAuraRange then
		return nil, nil
	end
	return targetRoot, localRoot
end

function Combat.StartSlapAura()
	if Combat.SlapAuraThread then
		return
	end
	Combat.SlapAuraThread = task.spawn(function()
		while Combat.SlapAuraEnabled do
			local remote = Combat.GetSlapRemote()
			local localCharacter = player.Character
			local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
			if remote and localRoot then
				for _, targetPlayer in ipairs(Players:GetPlayers()) do
					local targetRoot = Combat.CanUseSlapAuraTarget(targetPlayer, localCharacter, localRoot)
					if targetRoot then
						pcall(function()
							remote:FireServer(targetRoot)
						end)
					end
				end
			end
			task.wait(Combat.SlapAuraInterval)
		end
		Combat.SlapAuraThread = nil
	end)
end

function Combat.SetSlapAura(state, silent)
	Combat.SlapAuraEnabled = state == true
	ConfigData.SlapAura = state == true
	SaveConfig()
	if Combat.SlapAuraEnabled then
		Combat.StartSlapAura()
	end
end

local function GetPlayerInfo(target)
	local targetChar = target.Character
	if not targetChar then return "" end
	local output = {}
	if _G.Glive or ConfigData.Glove then
		local glove = target:FindFirstChild("Glove") or (target:FindFirstChild("leaderstats") and target.leaderstats:FindFirstChild("Glove"))
		if glove then
			table.insert(output, "Glove: " .. tostring(glove.Value))
		end
	end
	if ConfigData.Kills then
		local kills = targetChar:GetAttribute("Kills")
		if kills == nil and target:FindFirstChild("leaderstats") and target.leaderstats:FindFirstChild("Kills") then
			kills = target.leaderstats.Kills.Value
		end
		if kills ~= nil then
			table.insert(output, "Kills: " .. tostring(kills))
		end
	end
	if ConfigData.Power then
		local power = targetChar:GetAttribute("Power")
		if power == nil and targetChar:FindFirstChild("Power") then
			power = targetChar.Power.Value
		end
		if power == nil and target:FindFirstChild("leaderstats") and target.leaderstats:FindFirstChild("Power") then
			power = target.leaderstats.Power.Value
		end
		if power ~= nil then
			table.insert(output, "Power: " .. tostring(power))
		end
	end
	if ConfigData.Health then
		local hum = targetChar:FindFirstChildOfClass("Humanoid")
		if hum then
			table.insert(output, "HP: " .. tostring(math.floor(hum.Health + 0.5)) .. "/" .. tostring(math.floor(hum.MaxHealth + 0.5)))
		end
	end
	if ConfigData.Speed then
		local hum = targetChar:FindFirstChildOfClass("Humanoid")
		if hum then
			table.insert(output, "Speed: " .. tostring(math.floor(hum.WalkSpeed + 0.5)))
		end
	end
	if ConfigData.JumpPower then
		local hum = targetChar:FindFirstChildOfClass("Humanoid")
		if hum then
			local jp = hum.JumpPower > 0 and hum.JumpPower or hum.JumpHeight
			table.insert(output, "JumpPower: " .. tostring(math.floor(jp + 0.5)))
		end
	end
	return table.concat(output, "\n")
end

local function TP()
	if humanoidrootpart and humanoid then
		local direction = humanoid.MoveDirection
		if direction.Magnitude > 0 then
			direction = direction.Unit
			local boxCFrame, boxSize = character:GetBoundingBox()
			local rayParams = RaycastParams.new()
			rayParams.FilterType = Enum.RaycastFilterType.Exclude
			rayParams.FilterDescendantsInstances = {character}
			local result = workspace:Blockcast(boxCFrame, boxSize, direction * speeddistance, rayParams)
			local distance = speeddistance
			if result then
				distance = math.max(result.Distance - 0.5, 0)
			end
			if distance > 0 then
				humanoidrootpart.CFrame += direction * distance
			end
		end
	end
end

